<% content_for :bo_main_content do %>
<div class="bo-page-header"><h1><%= @campaign.persisted? ? 'Editar campanha de encomenda' : 'Nova campanha de encomenda' %></h1></div>
<div class="bo-page-body"><div class="card"><div class="card-body">
  <% if @campaign.errors.any? %><div class="alert alert-danger"><%= @campaign.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: @campaign, url: @campaign.persisted? ? bo_order_discount_campaign_path(params[:org_slug], @campaign) : bo_order_discount_campaigns_path(params[:org_slug]) do |f| %>
    <div class="mb-3"><%= f.label :name, 'Nome da campanha', class: 'form-label' %><%= f.text_field :name, required: true, class: 'form-control' %></div>
    <div class="mb-3"><%= f.label :priority, 'Prioridade — 1 é a mais alta', class: 'form-label' %><%= f.number_field :priority, min: 1, step: 1, required: true, class: 'form-control' %>
      <small class="text-muted">Entre campanhas com um patamar atingido, vence a de menor número. Só uma campanha automática é aplicada.</small></div>
    <%= render 'bo/shared/discount_category_scope', record: @campaign %>
    <%= f.submit 'Guardar campanha', class: 'btn btn-primary mt-3' %>
    <%= link_to 'Cancelar', bo_pricing_path(params[:org_slug], tab: 'order_tiers'), class: 'btn btn-outline-secondary mt-3' %>
  <% end %>
</div></div></div>
<% end %>
