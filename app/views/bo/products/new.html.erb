<% content_for :bo_main_content do%>

<div class="bo-page-header">
  <div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <%= link_to bo_products_path(params[:org_slug]), class: "text-muted text-decoration-none" do %>
        <i class="fa-solid fa-arrow-left fa-lg"></i>
      <% end %>

      <div class="rounded bg-secondary d-flex align-items-center justify-content-center text-white" style="width: 60px; height: 60px;">
        <i class="fa-solid fa-box-open fa-lg"></i>
      </div>

      <div>
        <h1><%= t('bo.products.new.title') %></h1>
        <span class="text-muted"><%= t('bo.products.new.subtitle') %></span>
      </div>
    </div>

    <div class="bo-page-actions">
      <%= link_to bo_products_path(params[:org_slug]), class: "btn btn-outline-secondary" do %>
        <%= t('bo.common.actions.cancel') %>
      <% end %>
      <button type="submit" form="product-form" class="btn btn-primary">
        <i class="fa-solid fa-check"></i> <%= t('bo.products.new.create_product') %>
      </button>
    </div>
  </div>
</div>

<div class="bo-page-body">

<%= form_with model: @product, url: bo_products_path(params[:org_slug]), method: :post, id: "product-form", multipart: true do |f| %>
  <% if @product.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <%= @product.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-8">
      <% unless @product.has_variants? %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title mb-4"><%= t('bo.product_variants.form.inventory') %></h5>
            <%= f.fields_for :inventory_attributes, @product.inventory_variant do |inventory| %>
              <%= render "bo/product_variants/inventory_fields", f: inventory, variant: @product.inventory_variant %>
              <div class="mt-3">
                <%= inventory.label :stock_policy, t('stock_management.policy'), class: "form-label" %>
                <%= inventory.select :stock_policy, ProductVariant::STOCK_POLICIES.map { |policy| [t("stock_management.policies.#{policy}"), policy] }, {}, class: "form-select" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= render "bo/products/basic_information", f: f %>

      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title mb-4"><%= t('bo.products.form.pricing_units') %></h5>

          <%= render "bo/products/price_and_unit", f: f %>

          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <label class="form-label"><%= t('bo.products.form.min_quantity') %></label>
              <%= f.number_field :min_quantity, class: "form-control", placeholder: "1", min: 1, value: 1 %>
            </div>
            <div class="col-md-6">
              <label class="form-label"><%= t('bo.products.form.min_quantity_type') %></label>
              <%= f.text_field :min_quantity_type, class: "form-control", placeholder: t('bo.products.form.placeholders.min_quantity_type') %>
            </div>
          </div>
        </div>
      </div>

      <% if @all_attributes.present? %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title mb-4"><%= t('bo.products.form.attributes', default: 'Atributos') %></h5>
            <p class="text-muted small mb-3"><%= t('bo.products.form.attributes_hint', default: 'Selecione atributos para catalogar este produto nos filtros da loja.') %></p>

            <% @all_attributes.each do |attribute, values| %>
              <%= render 'bo/product_variants/attribute_select',
                  attribute: attribute, values: values,
                  current_value_ids: [],
                  used_value_ids: [],
                  input_name: "product[attribute_value_ids][]" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= render "bo/products/images", f: f %>
      <%= render "bo/products/virtual_try_on", f: f %>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title mb-4"><%= t('bo.products.form.availability') %></h5>

          <div class="form-check form-switch">
            <%= f.check_box :published, class: "form-check-input", role: "switch", id: "publishedSwitch", checked: true %>
            <label class="form-check-label" for="publishedSwitch"><%= t('bo.products.form.published') %></label>
          </div>
          <small class="text-muted"><%= t('bo.products.form.unpublished_hint') %></small>

          <div class="form-check form-switch mt-3">
            <%= f.check_box :price_on_request, class: "form-check-input", role: "switch", id: "priceOnRequestSwitch" %>
            <label class="form-check-label" for="priceOnRequestSwitch"><%= t('bo.products.form.price_on_request') %></label>
          </div>
          <small class="text-muted"><%= t('bo.products.form.price_on_request_hint') %></small>

          <div class="form-check form-switch mt-3">
            <%= f.check_box :hide_sku_on_card, class: "form-check-input", role: "switch", id: "hideSkuOnCardSwitch" %>
            <label class="form-check-label" for="hideSkuOnCardSwitch"><%= t('bo.products.form.hide_sku_on_card') %></label>
          </div>
          <small class="text-muted"><%= t('bo.products.form.hide_sku_on_card_hint') %></small>
          <div class="form-check form-switch mt-3">
            <%= f.check_box :quick_add_enabled, class: "form-check-input", role: "switch" %>
            <%= f.label :quick_add_enabled, t('quick_add.settings.product'), class: "form-check-label" %>
          </div>
          <small class="text-muted d-block mb-3"><%= t('quick_add.settings.product_hint') %></small>
        </div>
      </div>
    </div>
  </div>
<% end %>

</div>

<% end %>
