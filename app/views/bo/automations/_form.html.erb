<%= form_with model: automation, url: url, method: method, data: { turbo: false } do |f| %>
  <% if automation.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% automation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-4"><i class="fa-solid fa-robot me-2"></i><%= t('bo.automations.form.what') %></h5>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label"><%= t('bo.automations.form.name') %></label>
          <%= f.text_field :name, class: "form-control", placeholder: t('bo.automations.form.name_placeholder') %>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t('bo.automations.form.kind') %></label>
          <%= f.select :kind,
                       @report_options.map { |o| [ o[:label], o[:key] ] },
                       {}, class: "form-select" %>
          <div class="form-text"><%= @report_options.first[:description] %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-4"><i class="fa-solid fa-clock me-2"></i><%= t('bo.automations.form.when') %></h5>

      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label"><%= t('bo.automations.form.frequency') %></label>
          <%= f.select :schedule_kind,
                       Automation::SCHEDULE_KINDS.map { |k| [ t("bo.automations.schedule_kinds.#{k}"), k ] },
                       {}, class: "form-select" %>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('bo.automations.form.day') %></label>
          <%= f.select :schedule_day,
                       (0..6).map { |d| [ t("date.day_names")[d], d ] },
                       { include_blank: t('bo.automations.form.day_blank') }, class: "form-select" %>
          <div class="form-text"><%= t('bo.automations.form.day_hint') %></div>
        </div>
        <div class="col-md-3">
          <label class="form-label"><%= t('bo.automations.form.hour') %></label>
          <%= f.select :schedule_hour,
                       (0..23).map { |h| [ format("%02d:00", h), h ] },
                       {}, class: "form-select" %>
          <div class="form-text"><%= t('bo.automations.form.timezone_hint', zone: current_organisation.timezone) %></div>
        </div>
        <div class="col-md-3">
          <div class="form-check">
            <%= f.check_box :skip_if_empty, class: "form-check-input" %>
            <label class="form-check-label"><%= t('bo.automations.form.skip_if_empty') %></label>
          </div>
          <div class="form-text"><%= t('bo.automations.form.skip_if_empty_hint') %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-4"><i class="fa-solid fa-filter me-2"></i><%= t('bo.automations.form.filters') %></h5>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label"><%= t('bo.automations.form.supplier') %></label>
          <%= select_tag "automation[filters][supplier]",
                         options_for_select(@suppliers, automation.filters["supplier"]),
                         include_blank: t('bo.automations.form.all_suppliers'), class: "form-select" %>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t('bo.automations.form.categories') %></label>
          <%= select_tag "automation[filters][category_ids][]",
                         options_for_select(@categories.map { |c| [ c.name, c.id ] },
                                            Array(automation.filters["category_ids"]).map(&:to_i)),
                         multiple: true, class: "form-select", size: 5 %>
          <div class="form-text"><%= t('bo.automations.form.categories_hint') %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-4"><i class="fa-solid fa-paper-plane me-2"></i><%= t('bo.automations.form.who') %></h5>

      <label class="form-label"><%= t('bo.automations.form.team') %></label>
      <div class="row g-2 mb-4">
        <% @org_members.each do |org_member| %>
          <div class="col-md-4">
            <div class="form-check">
              <%= check_box_tag "automation[recipients][org_member_ids][]", org_member.id,
                                automation.org_member_ids.include?(org_member.id),
                                id: "org_member_#{org_member.id}", class: "form-check-input" %>
              <label class="form-check-label" for="org_member_<%= org_member.id %>">
                <%= org_member.display_name %>
                <span class="text-muted small d-block"><%= org_member.display_email %></span>
              </label>
            </div>
          </div>
        <% end %>
      </div>

      <label class="form-label"><%= t('bo.automations.form.external') %></label>
      <%= text_area_tag "automation[external_emails_text]",
                        automation.external_emails.join(", "),
                        class: "form-control", rows: 2,
                        placeholder: "fornecedor@exemplo.pt, comercial@exemplo.pt" %>
      <div class="form-text"><%= t('bo.automations.form.external_hint') %></div>

      <div class="alert alert-warning mt-3 mb-0 small">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>
        <%= t('bo.automations.form.external_warning') %>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between">
    <%= link_to t('bo.common.actions.cancel'), bo_automations_path(current_organisation.slug),
                class: "btn btn-outline-secondary" %>
    <div>
      <% if automation.persisted? %>
        <%= button_to t('bo.automations.form.delete'),
                      bo_automation_path(current_organisation.slug, automation),
                      method: :delete, class: "btn btn-outline-danger me-2",
                      form: { class: "d-inline", data: { turbo_confirm: t('bo.automations.form.delete_confirm') } } %>
      <% end %>
      <%= f.submit t('bo.common.actions.save_changes'), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
