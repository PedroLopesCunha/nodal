<% content_for :bo_main_content do %>

<div class="bo-page-header">
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <h1><%= t('bo.automations.new.title') %></h1>
      <p class="text-muted mb-0"><%= t('bo.automations.new.subtitle') %></p>
    </div>
    <div class="bo-page-actions">
      <%= link_to bo_automations_path(current_organisation.slug), class: "btn btn-outline-secondary" do %>
        <%= t('bo.common.actions.cancel') %>
      <% end %>
      <button type="submit" form="automation-form" class="btn btn-primary">
        <i class="fa-solid fa-check"></i> <%= t('bo.common.actions.save_changes') %>
      </button>
    </div>
  </div>
</div>

<div class="bo-page-body">
  <%= render "form", automation: @automation,
             url: bo_automations_path(current_organisation.slug), method: :post %>
</div>

<% end %>
