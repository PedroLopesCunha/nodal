<% back_path = @bundle.persisted? ? bo_bundle_path(params[:org_slug], @bundle) : bo_bundles_path(params[:org_slug]) %>
<div class="bo-page-header">
  <div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <%= link_to back_path, class: "text-muted text-decoration-none", aria: { label: t("bundles.back") } do %>
        <i class="fa-solid fa-arrow-left fa-lg"></i>
      <% end %>
      <div class="rounded bg-secondary d-flex align-items-center justify-content-center text-white" style="width: 60px; height: 60px;">
        <i class="fa-solid fa-boxes-stacked fa-lg"></i>
      </div>
      <div><h1><%= title %></h1><span class="text-muted"><%= subtitle %></span></div>
    </div>
    <div class="bo-page-actions">
      <%= link_to t("bo.common.actions.cancel"), back_path, class: "btn btn-outline-secondary" %>
      <button type="submit" form="bundle-form" class="btn btn-primary">
        <i class="fa-solid fa-check"></i><%= @bundle.persisted? ? t("bo.common.actions.save_changes") : t("bundles.create") %>
      </button>
    </div>
  </div>
</div>
<div class="bo-page-body">
  <%= render "form" %>
</div>
