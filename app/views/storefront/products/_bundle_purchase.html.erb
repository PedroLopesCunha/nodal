<% unless browsing_as_member? %>
  <%= form_with url: order_bundles_path(org_slug: params[:org_slug]), method: :post, local: true, class: "w-100", id: "bundle-cart-form" do %>
    <%= hidden_field_tag :product_id, @product.id %>
  <% end %>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <div class="d-flex align-items-center">
        <%= label_tag :quantity, t("bundles.set_quantity"), class: "text-muted small me-2 mb-0" %>
        <%= render layout: "storefront/shared/quantity_stepper" do %>
          <%= number_field_tag :quantity, 1, form: "bundle-cart-form", required: true, min: 1, step: 1, class: "form-control text-center", style: "width:70px", data: { product_pricing_target: "quantity", action: "input->product-pricing#update" } %>
        <% end %>
      </div>
      <% if current_customer %>
        <%= render 'storefront/products/add_to_list_dropdown', product: @product, default_variant: @default_variant, has_variants: false, wrapper_class: '' %>
      <% end %>
    </div>
    <button type="submit" form="bundle-cart-form" class="btn btn-primary btn-lg w-100" style="border-radius:8px" <%= 'disabled' unless @product.bundle_purchasable? %>>
      <i class="fa-solid fa-cart-plus me-2"></i><%= t("storefront.products.show.add_to_cart") %><% if show_prices? %><span data-product-pricing-target="total"> · <%= money_amount(@actual_breakdown[:final_price]) %></span><% end %>
    </button>
<% end %>
