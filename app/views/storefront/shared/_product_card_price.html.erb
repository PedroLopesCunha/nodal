<%# Keep old and customer prices on separate rows. Range endpoints wrap as
    complete amounts, so currency symbols and digits never overlap. %>
<% has_flag = discount_info && discount_info[:all_discounts]&.any? { |d| [:product, :category, :customer_product, :variant].include?(d[:type]) } %>
<% has_erp_discount = discount_info&.dig(:erp_discount_percentage).to_d.positive? %>
<div class="product-card-prices">
  <% if product.price_on_request? %>
    <span class="product-card-price"><%= t('storefront.products.index.price_on_request') %></span>
  <% else %>
    <% range = product.variable? ? product.discounted_price_range(current_customer, for_display: !@honest_cards, cart_context: @cart_context) : nil %>
    <% original_min = range ? range[:original_min] : (discount_info&.dig(:base_price) || product.price) %>
    <% original_max = range ? range[:original_max] : original_min %>
    <% final_min = range ? range[:final_min] : (discount_info&.dig(:final_price) || product.price) %>
    <% final_max = range ? range[:final_max] : final_min %>
    <% show_original = (has_flag || has_erp_discount) && (original_min > final_min || original_max > final_max) %>
    <% if show_original %>
      <del class="product-card-price-original">
        <%= render 'storefront/shared/card_price_range', minimum: original_min, maximum: original_max %>
      </del>
    <% end %>
    <div class="<%= show_original ? 'product-card-price-discounted' : 'product-card-price' %>">
      <% if product.variable? && range.nil? %>
        <%= product.display_price %>
      <% else %>
        <%= render 'storefront/shared/card_price_range', minimum: final_min, maximum: final_max, show_from: true %>
      <% end %>
    </div>
  <% end %>
</div>
