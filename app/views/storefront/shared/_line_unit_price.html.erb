<% pricing = order_line_pricing(order).line(item) %>
<% if pricing.original_total > pricing.total %>
  <span class="text-muted text-decoration-line-through small d-block"><%= money_amount(item.price) %></span>
  <span class="text-success text-nowrap">
    <%= money_amount(pricing.unit_price) %>
    <% if pricing.campaign_savings.positive? && pricing.campaign_percentage %>
      <small>(-<%= format_discount_percentage(pricing.campaign_percentage) %>)</small>
    <% end %>
  </span>
  <% if item.discount_percentage.to_d.positive? %>
    <span class="badge bg-success-subtle text-success small"><%= t('storefront.line_pricing.product') %> -<%= format_discount_percentage(item.discount_percentage) %></span>
  <% end %>
<% else %>
  <%= money_amount(item.price) %>
<% end %>
